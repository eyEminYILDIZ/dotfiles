{
    "window.menuBarVisibility": "toggle",
    "workbench.iconTheme": "vscode-icons",
    "redhat.telemetry.enabled": false,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "hediet.vscode-drawio.theme": "Kennedy",
    "editor.fontSize": 12,
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/bin": true,
        "**/obj": true
    },
    // "vim.commandLineModeKeyBindings": [
    //     {
    //         "when": "editorTextFocus && vim.active && !inDebugRepl",
    //         "command": "extension.vim_escape",
    //         "key": "capslock",
    //     }
    // ],
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-v>": false,
        "<C-c>": false,
        "<C-x>": false,
        "<C-p>": false,
    },
    "window.zoomLevel": 1,
    "workbench.colorTheme": "Dark Modern",
    "hediet.vscode-drawio.resizeImages": null,
    "chat.viewSessions.orientation": "stacked",
    "hediet.vscode-drawio.codeLinkActivated": false,
    "claudeCode.preferredLocation": "sidebar",
    "git.openRepositoryInParentFolders": "always",
    "editor.minimap.enabled": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "git.confirmSync": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
        "*.csproj": "${capture}.csproj.user",
        "*.json": "${capture}.Development.json",
        "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
        "*.razor": "${capture}.razor.cs,${capture}.razor.css",
        "*.resx": "${capture}.Designer.cs",
        "*.xaml": "${capture}.xaml.cs",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "typescriptreact": true,
        "csharp": true,
        "typescript": true
    },
    "github.copilot.nextEditSuggestions.eagerness": "high",
    "editor.linkedEditing": true,
    "workbench.editor.enablePreview": false,
    "js/ts.referencesCodeLens.enabled": true,
    "js/ts.referencesCodeLens.showOnAllFunctions": true,
    "python.analysis.referencesCodeLens": true,
    "chat.tips.enabled": false,
    "workbench.editor.useModal": "some",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.suggest.quickSuggestions": {
        "commands": "on",
        "arguments": "on",
        "unknown": "on"
    },
    "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
    "terminal.integrated.tabs.title": "${squence}",
    "terminal.integrated.textBlinking": true,
    "terminal.integrated.confirmOnExit": "always",
}